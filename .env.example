# Copiez ce fichier en ".env" puis adaptez les valeurs.
NODE_ENV=development
PORT=3000

# Chemin du fichier de base de données SQLite
DATABASE_PATH=./data/quantum.db

# OBLIGATOIRE en production : chaîne aléatoire d'au moins 32 caractères
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Autoriser la création de comptes directeurs depuis le site (true/false)
ALLOW_REGISTRATION=true

# Durée de validité de la session (jours)
JWT_DAYS=7
